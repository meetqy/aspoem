{
  "name": "basic-template",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "imports": {
    "#globals.css": "./src/styles/globals.css"
  },
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=10.15.1"
  },
  "scripts": {
    "build": "pnpm db:deploy && next build",
    "db:dev": "prisma migrate dev --schema=./prisma/",
    "db:deploy": "prisma migrate deploy --schema=./prisma/",
    "db:push": "prisma db push --schema=./prisma/",
    "db:studio": "prisma studio --schema=./prisma/ --browser none",
    "dev": "next dev --turbo -p3333",
    "postinstall": "prisma generate --schema=./prisma/",
    "preview": "next build && next start",
    "start": "next start",
    "format:fix": "biome format --write",
    "lint:fix": "biome lint --write",
    "gen:markdown": "tsx scripts/chinese-poetry-to-markdown/index.ts",
    "gen:sql": "tsx scripts/poems-to-sql/index.ts",
    "ui:upgrade": "for file in src/components/ui/*.tsx; do npx shadcn@latest add -y -o $(basename \"$file\" .tsx); done",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.2",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.18.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "better-auth": "^1.3.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.544.0",
    "next": "16.0.1",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "opencc-js": "^1.0.5",
    "pinyin-pro": "^3.27.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.62.0",
    "server-only": "^0.0.1",
    "slugify": "^1.6.6",
    "sonner": "^2.0.7",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.3.11",
    "@biomejs/biome": "2.3.3",
    "@iconify/react": "^6.0.2",
    "@pinyin-pro/data": "^1.2.0",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.10",
    "@types/opencc-js": "^1.0.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "fs-extra": "^11.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "pangu": "^7.2.0",
    "postcss": "^8.5.3",
    "prettier": "^3.6.2",
    "prisma": "^6.18.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.8.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2"
    }
  }
}
