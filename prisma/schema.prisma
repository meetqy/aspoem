generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Poem {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  titleSlug        String
  titlePinyin      String // pinyin 用空格分隔 音调用数字
  paragraphs       String[]
  paragraphsPinyin String[]
  annotation       Json? // 注解

  visits    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  author   Author @relation(fields: [authorId], references: [id])
  authorId String
  tags     Tag[]

  @@map("poems")
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  visits    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  poems Poem[]

  @@map("tags")
}

model Author {
  id     String @id @default(cuid())
  name   String
  pinyin String
  slug   String @unique

  visits    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  dynasty   Dynasty @relation(fields: [dynastyId], references: [id])
  dynastyId String
  poems     Poem[]

  @@map("authors")
}

model Dynasty {
  id     String @id @default(cuid())
  name   String
  pinyin String
  slug   String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  authors Author[]

  @@map("dynasties")
}
