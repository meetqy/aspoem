generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Poem {
  id               String   @id @default(cuid())
  title            String
  titleSlug        String   @unique
  titlePinyin      String
  author           String
  authorPinyin     String
  authorSlug       String   @unique
  dynasty          String
  dynastyPinyin    String
  dynastySlug      String
  paragraphs       String[]
  paragraphsPinyin String[]
  annotation       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("poems")
}
